<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SDK 10 cannot build net11.0, so net11.0 is added only when SDK 11 or later builds; CI installs both SDKs so the package ships both. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Solrevdev.Logging.AspNetCore</RootNamespace>
    <AssemblyName>Solrevdev.Logging.AspNetCore</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Every public member needs XML docs or the build fails. That is deliberate:
         this package exists to carry hard-won reasons between three applications,
         and a member shipped without its reason is the drift it exists to stop. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>solrevdev.Logging.AspNetCore</PackageId>

    <!-- The release number. CI publishes this version as it stands while no tag
         names it, and bumps the patch once v<this> exists; larger bumps go through
         workflow_dispatch. Raising it by hand here is how a minor or major is chosen. -->
    <Version>1.2.0</Version>

    <!-- NuGet metadata -->
    <Authors>solrevdev</Authors>
    <Company>solrevdev</Company>
    <Product>Solrevdev.Logging.AspNetCore</Product>
    <Copyright>Copyright (c) solrevdev</Copyright>
    <Title>Solrevdev.Logging.AspNetCore — Serilog request logging for ASP.NET Core</Title>
    <PackageDescription>Shared Serilog request-logging infrastructure for ASP.NET Core on .NET 10 and .NET 11: a readable client address, the X-Forwarded-For the caller actually claimed, a referer with its query string stripped, static-file and probe summaries demoted to Verbose, log-context middleware split either side of the rate limiter, and a property contract each application can test against.</PackageDescription>
    <PackageTags>serilog;logging;aspnetcore;seq;request-logging;diagnostics;middleware;observability</PackageTags>
    <RepositoryUrl>https://github.com/solrevdev/solrevdev.logging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/solrevdev/solrevdev.logging</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/solrevdev/solrevdev.logging/blob/master/CHANGELOG.md</PackageReleaseNotes>

    <!-- Ship symbols so stack traces from a published build are readable. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- where pack puts .nupkg -->
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <!-- Reproducible builds on CI only: setting this locally breaks debugging. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The version all three consuming applications are on. Serilog.AspNetCore
         brings IDiagnosticContext, LogContext and UseSerilogRequestLogging. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Solrevdev.Logging.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet.org strips raw HTML, so the package gets its own readme rather
         than the GitHub one. -->
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />

    <!-- nuget.org renders the embedded icon, not a URL, and wants a small raster.
         The SVG in docs/assets/branding is the source; the 128px PNG is generated
         from it with rsvg-convert and both move together. -->
    <None Include="../../docs/assets/branding/logging-icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>

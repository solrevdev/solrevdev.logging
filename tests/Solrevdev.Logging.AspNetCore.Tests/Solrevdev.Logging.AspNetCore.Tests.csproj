<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- SDK 10 cannot build net11.0, so net11.0 is added only when SDK 11 or later builds; CI installs both SDKs so the package ships both. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Solrevdev.Logging.AspNetCore.Tests</RootNamespace>
    <AssemblyName>Solrevdev.Logging.AspNetCore.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 generates the entry point for its self-running test executable. -->
    <OutputType>Exe</OutputType>

    <!-- The Razor SDK compiles the two pages under Pages/ into this assembly, so the refusal
         filters are tested through real Razor Pages on a TestServer. Nothing else needs it. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The versions both sibling applications are on. xunit.v3 3.2.2 with
      xunit.runner.visualstudio 3.1.5 is the combination that works on the .NET 10
      SDK under VSTest; the xunit v4 packages move to Microsoft.Testing.Platform,
      which is a separate migration and not one to make inside a library.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- Test only. One 10.0 build serves both targets; the 11.0 package has no net10.0 asset. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Solrevdev.Logging.AspNetCore\Solrevdev.Logging.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
